generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Enums ─────────────
enum Role {
  STUDENT
  TEACHER
  ADMIN
}
enum UserStatus {
  ACTIVE
  LOCKED
}
enum CourseStatus {
  DRAFT
  PUBLISHED
}
enum ContentType {
  VIDEO
  PDF
}
enum ExamStatus {
  DRAFT
  OPEN
  CLOSED
}
enum DocStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

// ───────────── Users ─────────────
model User {
  id           String     @id @default(uuid()) @db.Uuid
  studentCode  String?    @unique @map("student_code") @db.VarChar(20)
  fullName     String     @map("full_name") @db.VarChar(100)
  email        String     @unique @db.VarChar(150)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         Role       @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  coursesTaught  Course[]         @relation("CourseTeacher")
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  attempts       Attempt[]
  aiDocuments    AiDocument[]
  aiMessages     AiMessage[]

  @@map("users")
}

// ───────────── Courses ─────────────
model Course {
  id          String       @id @default(uuid()) @db.Uuid
  title       String       @db.VarChar(200)
  description String       @default("") @db.Text
  topic       String       @db.VarChar(100)
  level       String       @db.VarChar(20)
  status      CourseStatus @default(DRAFT)
  teacherId   String       @map("teacher_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  teacher     User         @relation("CourseTeacher", fields: [teacherId], references: [id])
  modules     Module[]
  enrollments Enrollment[]
  exams       Exam[]
  aiDocuments AiDocument[]
  aiMessages  AiMessage[]

  @@index([teacherId])
  @@index([status])
  @@map("courses")
}

model Module {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @map("course_id") @db.Uuid
  title    String @db.VarChar(200)
  position Int

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  exams   Exam[]

  @@index([courseId, position])
  @@map("modules")
}

model Lesson {
  id              String      @id @default(uuid()) @db.Uuid
  moduleId        String      @map("module_id") @db.Uuid
  title           String      @db.VarChar(200)
  contentType     ContentType @map("content_type")
  fileUrl         String?     @map("file_url") @db.Text
  filePublicId    String?     @map("file_public_id") @db.VarChar(255)
  durationSeconds Int?        @map("duration_seconds")
  position        Int
  isPublished     Boolean     @default(false) @map("is_published")

  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  aiDocument  AiDocument?

  @@index([moduleId, position])
  @@map("lessons")
}

// ───────────── Enrollment & Progress ─────────────
model Enrollment {
  userId      String    @map("user_id") @db.Uuid
  courseId    String    @map("course_id") @db.Uuid
  enrolledAt  DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@id([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  userId      String   @map("user_id") @db.Uuid
  lessonId    String   @map("lesson_id") @db.Uuid
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// ───────────── Exams ─────────────
model Exam {
  id              String     @id @default(uuid()) @db.Uuid
  courseId        String     @map("course_id") @db.Uuid
  moduleId        String?    @map("module_id") @db.Uuid
  title           String     @db.VarChar(200)
  durationMinutes Int        @map("duration_minutes")
  passScore       Decimal    @default(5) @map("pass_score") @db.Decimal(4, 2)
  status          ExamStatus @default(DRAFT)

  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module    Module?    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  Attempt[]

  @@index([courseId])
  @@index([moduleId])
  @@map("exams")
}

model Question {
  id       String @id @default(uuid()) @db.Uuid
  examId   String @map("exam_id") @db.Uuid
  content  String @db.Text
  position Int

  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  options Option[]
  answers Answer[]

  @@index([examId, position])
  @@map("questions")
}

model Option {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  content    String  @db.Text
  isCorrect  Boolean @default(false) @map("is_correct")
  position   Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  Answer[]

  @@index([questionId, position])
  @@map("options")
}

// ───────────── Attempts ─────────────
model Attempt {
  id             String   @id @default(uuid()) @db.Uuid
  examId         String   @map("exam_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  attemptNo      Int      @map("attempt_no")
  correctCount   Int      @map("correct_count")
  totalQuestions Int      @map("total_questions")
  score          Decimal  @db.Decimal(4, 2)
  submittedAt    DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Restrict)
  student User     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  answers Answer[]

  @@unique([examId, studentId, attemptNo])
  @@index([examId])
  @@index([studentId])
  @@map("attempts")
}

model Answer {
  id         String @id @default(uuid()) @db.Uuid
  attemptId  String @map("attempt_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  optionId   String @map("option_id") @db.Uuid

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  option   Option   @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("answers")
}

// ───────────── AI ─────────────
model AiDocument {
  id           String    @id @default(uuid()) @db.Uuid
  courseId     String    @map("course_id") @db.Uuid
  lessonId     String?   @unique @map("lesson_id") @db.Uuid
  uploadedBy   String    @map("uploaded_by") @db.Uuid
  fileName     String    @map("file_name") @db.VarChar(255)
  fileUrl      String    @map("file_url") @db.Text
  filePublicId String?   @map("file_public_id") @db.VarChar(255)
  status       DocStatus @default(PENDING)
  errorMessage String?   @map("error_message") @db.VarChar(100)
  uploadedAt   DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploadedBy], references: [id])

  @@index([courseId])
  @@index([uploadedBy])
  @@map("ai_documents")
}

model AiMessage {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  question  String   @db.Text
  answer    String   @db.Text
  sources   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, courseId, createdAt])
  @@map("ai_messages")
}
